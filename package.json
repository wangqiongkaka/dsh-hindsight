{
  "name": "dsh-hindsight",
  "version": "0.1.0",
  "description": "DSH Hindsight 控制台与模型管理插件",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-locale"] }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "prepack": "npm run build"
  },
  "dependencies": { "ajv": "8.17.1" },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.4", "@deepseek-ai/schemastery": "^3.18.4", "react": "^18.2.0", "react-dom": "^18.2.0" },
  "devDependencies": { "esbuild": "0.28.1", "@playwright/test": "1.62.0" }
}
